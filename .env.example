# Copy to .env and edit. Never commit real secrets.

# ---- backend (prefix OSINT_)
OSINT_ENVIRONMENT=development
OSINT_DATABASE_URL=postgresql+psycopg://osint:osint@postgres:5432/osint
OSINT_ARTIFACT_DIR=/data/artifacts
OSINT_JWT_SECRET=change-me-to-a-long-random-string
OSINT_ADMIN_USERNAME=admin
OSINT_ADMIN_PASSWORD=change-me
OSINT_CORS_ORIGINS=["http://localhost:3000"]

# Discovery policy
OSINT_MAX_DISCOVERY_DEPTH=2
OSINT_REUSE_WINDOW_HOURS=168
OSINT_AUTO_APPROVE_CATEGORIES=["blockchain_verification"]

# Optional providers (unset = provider reports "unavailable"; nothing is fabricated)
# OSINT_EVM_RPC_URLS={"ethereum":"https://your-rpc.example"}
# OSINT_SOLANA_RPC_URL=https://your-solana-rpc.example
# OSINT_SHERLOCK_BINARY=sherlock

# Optional LLM (default none)
OSINT_LLM_PROVIDER=none
# OSINT_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
# OSINT_LLM_MODEL=your-model
# OSINT_LLM_API_KEY=

# ---- frontend (browser-visible; baked at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- compose infrastructure (Redis is provisioned but not yet used by code; see ADR-0006)
POSTGRES_USER=osint
POSTGRES_PASSWORD=osint
POSTGRES_DB=osint
